# Copy this file to .env and enter your real values there. Never commit .env.
# No API key is required for the default Ollama provider.

# Optional model overrides
RAG_FEATURE_MODEL=llama3.2
RAG_RERANK_MODEL=llama3.2
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=3072
# Built once from the supplied master JSON. Use an absolute path if the NPZ is
# stored outside this repository.
RAG_VECTOR_STORE_PATH=ultimate_pocketfm_vector_store.npz
# For Databricks Apps, set RAG_VECTOR_STORE_VOLUME to the directory supplied by
# a Unity Catalog volume resource instead of committing the NPZ to Git.
# RAG_VECTOR_STORE_VOLUME=/Volumes/<catalog>/<schema>/<volume>
RAG_REASONING_EFFORT=low
# Keep interactive search responsive when the embedding service is unavailable.
RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=12
RAG_QUERY_EMBEDDING_MAX_RETRIES=1
RAG_TTS_MODEL=
RAG_TTS_TIMEOUT_SECONDS=90
RAG_TTS_MAX_RETRIES=1
RAG_TRANSCRIPTION_MODEL=

# Provider options: openai, ollama, groq, or gemini. Ollama is local/free.
RAG_LLM_PROVIDER=ollama
RAG_SEARCH_MODE=auto
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=
GEMINI_API_KEY=
