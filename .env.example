# Copy this file to .env and enter your real values there. Never commit .env.
OPENAI_API_KEY=

# Optional model overrides
RAG_FEATURE_MODEL=gpt-5.6-sol
RAG_RERANK_MODEL=gpt-5.6-terra
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=3072
RAG_REASONING_EFFORT=low
# Keep interactive search responsive when the embedding service is unavailable.
RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=12
RAG_QUERY_EMBEDDING_MAX_RETRIES=1
RAG_TTS_MODEL=gpt-audio-1.5
RAG_TTS_TIMEOUT_SECONDS=90
RAG_TTS_MAX_RETRIES=1
RAG_TRANSCRIPTION_MODEL=gpt-4o-transcribe
